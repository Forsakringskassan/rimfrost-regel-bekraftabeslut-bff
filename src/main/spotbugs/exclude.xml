<FindBugsFilter>
  <!-- Records used as internal DTOs — EI_EXPOSE_REP is a false positive;
       objects are never mutated externally; they carry data through the BFF layer. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Or>
      <Class name="se.fk.github.bekraftabeslutbff.model.PatchRequest"/>
      <Class name="se.fk.github.bekraftabeslutbff.model.BackendGetResponse"/>
    </Or>
  </Match>
</FindBugsFilter>
